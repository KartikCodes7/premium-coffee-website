datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String // 'Owner' | 'Chef' | 'Guest'
  createdAt DateTime @default(now())
}

model Order {
  id           String   @id @default(uuid())
  ticketNumber String   @unique // e.g. #OS-8902
  customerName String
  items        String // comma separated values or stringified list
  total        Float
  status       String // 'Pending' | 'Preparing' | 'Served' | 'Completed'
  time         String // hour string, e.g. '19:42'
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  text      String
  time      String // e.g. '19:42'
  type      String // 'info' | 'success' | 'warning' | 'error'
  createdAt DateTime @default(now())
}

model Transaction {
  id           String   @id @default(uuid())
  ticketNumber String   @unique // e.g. #ROS-9241
  customerName String
  items        String
  total        Float
  status       String // 'Served' | 'Preparing' | 'Pending'
  time         String // e.g. 'Today, 18:45'
  createdAt    DateTime @default(now())
}
